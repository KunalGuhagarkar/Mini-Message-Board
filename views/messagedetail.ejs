<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />    
    <title>Document</title>
  </head>
  <body>
    <style>
      /* Center the content */
      body {
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: #f5f7fb;
        padding: 40px;
        font-family: Arial, sans-serif;
      }

      /* Style each detail line like a card */
      body > p {
        width: 100%;
        max-width: 500px;
        background: white;
        padding: 15px 20px;
        margin: 8px 0;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
        color: #333;
      }

      /* Highlight user */
      body > p:first-of-type {
        font-weight: bold;
        color: #2c3e50;
      }

      /* Message text */
      body > p:nth-of-type(2) {
        font-size: 16px;
      }

      /* Date styling */
      body > p:nth-of-type(3) {
        font-size: 13px;
        color: #777;
      }

      /* Button */
      button {
        margin-top: 20px;
        padding: 10px 16px;
        border: none;
        border-radius: 6px;
        background-color: #7f8c8d;
        color: white;
        cursor: pointer;
      }

      button:hover {
        background-color: #636e72;
      }
    </style>
    <p>User: <%= messages.user %></p>
    <p>Message: <%= messages.text %></p>
    <p>Date: <%= messages.added %></p>
    <a href="/"><button>Go Back to Home</button></a>
  </body>
</html>
