<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>Index Page</title>
</head>
<body>
    <ul>
        <% for(let i=0; i < messages.length; i++){ %>
        <li>
            <p>User: <%= messages[i].user %></p>
            <p>Message: <%= messages[i].text %></p>
            <p>Date: <%= messages[i].added %></p>
            <a href="/messagedetails/<%= i %>"><button>View Details</button></a>
        </li>
        <% } %>
        <br>
        <a href="/new"><button>Add New Message</button></a>
    </ul>
</body>
</html>